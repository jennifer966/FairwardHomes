# ---------------------------------------------------------------------------
# Site mode & launch controls
# ---------------------------------------------------------------------------
# "prelaunch" (default) or "live". LIVE is ignored until every field in
# src/config/site.ts → compliance is supplied and approvedForLive is true.
NEXT_PUBLIC_SITE_MODE=prelaunch
# "test" (default: stored, flagged as test data), "enabled", or "disabled".
# Only use "enabled" after public-facing legal & privacy review.
NEXT_PUBLIC_LEAD_CAPTURE=test
NEXT_PUBLIC_SITE_URL=https://fairwardhomes.com

# Optional: password-protect the whole private preview (HTTP Basic auth).
PREVIEW_USER=preview
PREVIEW_PASSWORD=

# Internal lead view at /admin/leads (disabled/404 when ADMIN_PASSWORD is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase (server-only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email notifications (optional — Resend). Leads are stored regardless; when
# unset, notification_status is recorded as "not_configured".
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=
LEAD_NOTIFICATION_TO=

# ---------------------------------------------------------------------------
# Analytics: "none" (default) or "first-party" (cookieless, stored in Supabase).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS=none

# Salt for hashing IPs in the in-memory rate limiter.
RATE_LIMIT_SALT=change-me
